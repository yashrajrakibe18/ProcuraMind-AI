# Copy to .env and edit. NEVER commit .env. Values below are placeholders, not credentials.
APP_NAME=ProcureAI
APP_ENV=development            # development | test | production
DEBUG=false
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# --- Security. Production refuses to start with the default key. ---
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=true        # first registered user becomes admin; set false after creating your users

# --- Persistence (SQLite by default for zero-setup local use; PostgreSQL for real deployments) ---
DATABASE_URL=sqlite:///./storage/procureai.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/procureai
AUTO_CREATE_TABLES=true        # dev/test convenience; set false and use `alembic upgrade head` in production
POSTGRES_PASSWORD=change-me    # used by docker-compose
VECTOR_STORE_PATH=./storage/chroma
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=300
ALLOWED_EXTENSIONS=.pdf,.txt,.csv,.md,.png,.jpg,.jpeg

# --- LLM (optional). none = fully deterministic/offline. anthropic | openai enables advisory interpretation
# --- of ambiguous specs and generated assistant answers (citations are still verified). ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=hashing-v1     # local deterministic embedder, no downloads

# --- Analysis ---
BASE_CURRENCY=USD
# Static, ILLUSTRATIVE FX table (value of 1 unit in the base currency). Replace with real rates before real use.
FX_RATES_JSON={"USD":1.0,"EUR":1.08,"GBP":1.27,"INR":0.012}
PRICE_THRESHOLD_PCT=25
RAG_MIN_SCORE=0.12
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
WORKFLOW_STEP_MAX_RETRIES=2
WORKFLOW_STEP_TIMEOUT_SECONDS=120

# --- Web UI ---
API_BASE_URL=http://localhost:8000/api/v1

# --- ProcuraMind platform ---
# Run the in-process workflow scheduler (single API process only; use external cron for several replicas).
SCHEDULER_ENABLED=false
# Allow webhooks to private/loopback addresses (development only; keep false in production).
ALLOW_PRIVATE_WEBHOOKS=false
